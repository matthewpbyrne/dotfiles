#!/usr/bin/env bash
# finfile: rename and file documents into the ~/Finance filing system
#
# Usage:
#   finfile [-n] FILE...
#
#   -n  dry run: show the target path, move nothing
#
# Picks the account from 00_Admin/accounts.csv and the DocType from
# 00_Admin/doctypes.txt, builds
#   YYYY-MM-DD_Institution_Account_DocType[_note].ext
# and moves the file into the account's folder, adding a year folder when
# the account's year_folders column is "yes" (document year) or "tax"
# (tax year). See 00_Admin/README.org.
#
# Environment:
#   FINANCE_DIR  filing root (default: ~/Finance)

set -euo pipefail

FINANCE_DIR="${FINANCE_DIR:-$HOME/Finance}"
ACCOUNTS="$FINANCE_DIR/00_Admin/accounts.csv"
DOCTYPES="$FINANCE_DIR/00_Admin/doctypes.txt"
DRY_RUN=0

die() {
	printf 'finfile: %s\n' "$*" >&2
	exit 1
}

warn() {
	printf 'finfile: %s\n' "$*" >&2
}

usage() {
	sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
}

# ask VAR PROMPT [DEFAULT] -- read a line into VAR, pre-filled with DEFAULT
ask() {
	read -r -e -p "$2" -i "${3:-}" "$1"
}

# Keep only filename-safe characters for a name component (no "_").
clean() {
	local s=${1// /-}
	s=$(printf '%s' "$s" | tr -cd 'A-Za-z0-9-' | tr -s '-')
	s=${s#-}
	printf '%s' "${s%-}"
}

valid_date() {
	[[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] &&
		[[ $(date -d "$1" +%F 2>/dev/null) == "$1" ]]
}

# Open accounts as id|institution|account|type|country|folder|year_folders
accounts_list() {
	gawk -v FPAT='([^,]*)|("[^"]*")' -v OFS='|' '
		function get(name) { return (name in col) ? $col[name] : "" }
		{ sub(/\r$/, "") }
		NR == 1 { for (i = 1; i <= NF; i++) col[$i] = i; next }
		NF == 0 { next }
		{
			for (i = 1; i <= NF; i++) gsub(/^"|"$/, "", $i)
			if (get("status") == "closed") next
			print get("id"), get("institution"), get("account"), get("type"),
				get("country"), get("folder"), get("year_folders")
		}' "$ACCOUNTS"
}

# Candidate document dates found in the file's text, then its mtime.
date_candidates() {
	local file=$1 text=
	case ${file,,} in
	*.pdf)
		if command -v pdftotext >/dev/null 2>&1; then
			text=$(pdftotext -l 2 "$file" - 2>/dev/null || true)
		fi
		;;
	*.txt | *.eml | *.csv | *.org | *.md)
		text=$(head -c 20000 "$file")
		;;
	esac
	{
		grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' <<<"$text" || true
		grep -oE '\b[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}\b' <<<"$text" |
			awk -F/ '{ printf "%04d-%02d-%02d\n", $3, $2, $1 }' || true
		grep -oiE '\b[0-9]{1,2} (jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]* [0-9]{4}\b' <<<"$text" |
			while read -r d; do date -d "$d" +%F 2>/dev/null || true; done || true
		date -r "$file" +%F
	} | while read -r d; do
		if valid_date "$d"; then printf '%s\n' "$d"; fi
	done | awk '!seen[$0]++'
}

# Most recently ended tax year for a document date: IE "2024", UK "2024-25".
tax_year_default() {
	local y=$((10#${1:0:4})) md=$((10#${1:5:2}${1:8:2}))
	if [[ $2 == UK ]]; then
		if ((md >= 406)); then
			printf '%d-%02d' $((y - 1)) $((y % 100))
		else
			printf '%d-%02d' $((y - 2)) $(((y - 1) % 100))
		fi
	else
		printf '%d' $((y - 1))
	fi
}

pick_account() {
	{
		accounts_list
		printf 'OTHER|(not in register)|||||\n'
	} | fzf --delimiter='\|' --with-nth=1,2,3,4,6 --prompt='Account> ' \
		--header='Pick the account (Esc aborts)'
}

pick_folder() {
	(cd "$FINANCE_DIR" && find . -mindepth 1 -type d \
		-not -path './00_Admin*' -not -path './01_Inbox*' | sed 's|^\./||' | sort) |
		fzf --print-query --prompt='Folder> ' \
			--header='Pick a folder, or type a new path and press Enter' |
		awk 'NR == 1 { q = $0 } NR == 2 { s = $0 } END { print (s != "" ? s : q) }'
}

pick_date() {
	local file=$1 out rc=0 d
	out=$(date_candidates "$file" | fzf --print-query --prompt='Date> ' \
		--header='Document date: pick one found in the file, or type YYYY-MM-DD') || rc=$?
	((rc == 130)) && return 1
	d=$(sed -n 2p <<<"$out")
	[[ -n $d ]] || d=$(sed -n 1p <<<"$out")
	while ! valid_date "$d"; do
		ask d 'Date (YYYY-MM-DD): ' "$d"
	done
	printf '%s' "$d"
}

pick_doctype() {
	grep -vE '^\s*(#|$)' "$DOCTYPES" |
		fzf --prompt='DocType> ' --header='Document type' |
		awk '{ print $1 }'
}

file_one() {
	local src=$1 line id inst acct type country folder yf
	local date doctype note ext name sub='' dest reply
	[[ -f $src ]] || {
		warn "not a file: $src"
		return 1
	}
	printf '\n== %s\n' "$src"

	line=$(pick_account) || return 1
	IFS='|' read -r id inst acct type country folder yf <<<"$line"
	if [[ $id == OTHER ]]; then
		inst='' acct=''
		folder=$(pick_folder) || return 1
		[[ -n $folder ]] || return 1
		ask yf 'Year folders (no/yes/tax): ' no
		if [[ $yf == tax ]]; then ask country 'Country (IE/UK): ' IE; fi
	else
		printf 'Account: %s %s (%s)\n' "$inst" "$acct" "$type"
	fi
	ask inst 'Institution: ' "$inst"
	ask acct 'Account (blank for none): ' "$acct"
	inst=$(clean "$inst")
	acct=$(clean "$acct")
	[[ -n $inst ]] || {
		warn 'institution is required'
		return 1
	}

	date=$(pick_date "$src") || return 1
	doctype=$(pick_doctype) || return 1
	[[ -n $doctype ]] || return 1
	ask note 'Note (optional): '
	note=$(clean "${note,,}")

	ext=
	if [[ $(basename -- "$src") == *.* ]]; then ext=${src##*.}; fi
	ext=${ext,,}

	name="${date}_${inst}${acct:+_$acct}_${doctype}${note:+_$note}${ext:+.$ext}"

	case $yf in
	yes) sub=${date:0:4} ;;
	tax) ask sub 'Tax year: ' "$(tax_year_default "$date" "$country")" ;;
	esac

	dest="$FINANCE_DIR/${folder%/}${sub:+/$sub}/$name"
	printf '\n  %s\n  -> %s\n' "$src" "${dest#"$FINANCE_DIR"/}"
	if [[ -e $dest ]]; then
		warn "already exists, skipping: $dest"
		return 1
	fi
	if ((DRY_RUN)); then
		printf '  (dry run, nothing moved)\n'
		return 0
	fi
	read -r -p 'Move? [y/N] ' reply
	[[ $reply == [yY]* ]] || {
		printf '  skipped\n'
		return 0
	}
	mkdir -p -- "$(dirname -- "$dest")"
	mv -n -- "$src" "$dest"
	if [[ -e $src ]]; then
		warn "move failed: $src"
		return 1
	fi
	printf '  filed. Update registers if this opened/closed an account or holding.\n'
}

main() {
	local opt rc=0 f
	while getopts ':nh' opt; do
		case $opt in
		n) DRY_RUN=1 ;;
		h)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 2
			;;
		esac
	done
	shift $((OPTIND - 1))
	(($# > 0)) || {
		usage >&2
		exit 2
	}

	command -v fzf >/dev/null 2>&1 || die 'fzf is required'
	command -v gawk >/dev/null 2>&1 || die 'gawk is required'
	[[ -f $ACCOUNTS ]] || die "missing $ACCOUNTS"
	[[ -f $DOCTYPES ]] || die "missing $DOCTYPES"

	for f in "$@"; do
		file_one "$f" || rc=1
	done
	return "$rc"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
